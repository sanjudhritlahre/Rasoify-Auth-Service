{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "The User Management Service for Rasoify!",
  "homepage": "https://github.com/sanjudhritlahre/Rasoify-Auth-Service#readme",
  "bugs": {
    "url": "https://github.com/sanjudhritlahre/Rasoify-Auth-Service/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanjudhritlahre/Rasoify-Auth-Service.git"
  },
  "license": "ISC",
  "author": "Sanju Dhritlahre",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand --watchAll=false",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "cross-env NODE_ENV=dev nodemon --exec ts-node src/server.ts",
    "fmt:fix": "prettier . --write",
    "fmt:check": "prettier . --check",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.1",
    "@types/winston": "^2.4.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.0.8",
    "nodemon": "^3.1.14",
    "prettier": "3.9.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "lint-staged": {
    "*.ts": [
      "npm run fmt:fix",
      "npm run lint:fix"
    ]
  },
  "dependencies": {
    "@jest/globals": "^29.7.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "winston": "^3.19.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
